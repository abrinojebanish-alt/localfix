# Public (safe for browser) — from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a client component.
# Used only in scripts/seed.ts and any future server-only admin action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app (used for metadata / OG tags / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
